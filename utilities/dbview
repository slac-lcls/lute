#!/bin/bash
usage()
{
cat << EOF
$(basename "$0"):
    Launch a TUI app to inspect a LUTE database.
    Options:
        -h|--help
          Display this message.
        -p|--path
          Path to the LUTE SQLite database.
        --summarize
          Provide a pivoted and reorganized view if using database v0.2.
EOF
}

POS=()
while [[ $# -gt 0 ]]
do
    flag="$1"

    case $flag in
        -h|--help)
          usage
          exit
          ;;
        -p|--path)
          DBPATH="$2"
          shift
          shift
          ;;
        --summarize)
          SUMMARIZE=1
          shift
          ;;
    esac
done
set -- "${POS[@]}"

if [[ -z ${DBPATH} ]]; then
    echo "Please provide a database path!"
    usage
    exit
fi

export APP_DIR="$( cd "$( dirname "${BASH_SOURCE[0]}" )" &> /dev/null && pwd )/src/dbview"
export LUTE_BASE="${APP_DIR}/../../.."

if [[ $HOSTNAME =~ "sdf" ]]; then
    source /sdf/group/lcls/ds/ana/sw/conda1/manage/bin/psconda.sh
fi

if [[ -z ${SUMMARIZE} ]]; then
    python -B ${APP_DIR}/dbview.py -p $DBPATH
else
    python -B ${APP_DIR}/dbview.py -p $DBPATH --summarize
fi
